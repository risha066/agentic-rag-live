# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Any OpenAI open-weight model hosted on Groq. No Llama models used.
# Options: openai/gpt-oss-20b (fast, default) | openai/gpt-oss-120b (larger, stronger)
GROQ_MODEL=openai/gpt-oss-20b

# low | medium | high — only used by the gpt-oss reasoning models
GROQ_REASONING_EFFORT=medium

# Local embedding model (runs on CPU via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the persistent Chroma vector store lives on disk
VECTOR_DB_DIR=./chroma_db

MAX_SEARCH_RESULTS=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_AGENT_STEPS=6
